# Build directory

/build
# Retired name for the Release tree (pre build/release): kept ignored so a stale
# command cannot dirty the tree.
/build-rel
/CMakeCache.txt

# scratch files
/src/scratch
.DS_Store
# the main binary
/main

# OfflineRender writes its check WAVs here on every run (delta-L*.wav, ~20 MB).
/offline-render/


/CMakeFiles
/research

/plan
/design

# Assistant scratch. Everything written under .qwen/tmp is generated working
# material — captured run output, comparison baselines, one-use scripts, and the
# TMPDIR the LTO link needs — none of it source of truth. The rest of .qwen/
# (skills, agents, settings) is deliberate repo content and stays tracked.
/.qwen/tmp/

# Ad-hoc captures and crash artefacts, wherever a debugging run drops them.
/*.log
*.bak
*.orig
*.rej
/core
/core.*
*.dmp
asan.log*
ubsan.log*
__pycache__/
*.pyc
