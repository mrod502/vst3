#!/bin/bash
# Usage: cmd/install [debug|release]   (default: release)
# Trees live in $BUILD_ROOT/<config>: the repo-relative build/<config> on the host, and
# /ct/build/<config> in the container, where compose sets BUILD_ROOT to the build volume.

cd "$(dirname "$0")/.." || exit 1
config="${1:-release}"
root="${BUILD_ROOT:-build}"

case "$config" in
    debug)   buildType=Debug ;;
    release) buildType=Release ;;
    *)       echo "usage: cmd/install [debug|release]" >&2; exit 2 ;;
esac

git submodule update --init --recursive && cmake -G Ninja -S . -B "$root/$config" -DCMAKE_BUILD_TYPE="$buildType"
